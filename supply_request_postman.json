{
	"info": {
		"_postman_id": "a5c79b12-14a5-47a9-a7d4-c4a4d2e5c6bf",
		"name": "Supply Request Management",
		"description": "API endpoints for managing supply requests in the association application.",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get All Supply Requests",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests"
					]
				},
				"description": "Get a list of all supply requests with related product or material information."
			},
			"response": []
		},
		{
			"name": "Get Supply Request By ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests",
						"1"
					]
				},
				"description": "Get a specific supply request by its ID with related product or material details."
			},
			"response": []
		},
		{
			"name": "Create Supply Request",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"product\",\n    \"productId\": 1,\n    \"quantity\": 10,\n    \"source\": \"Local supplier\",\n    \"notes\": \"Need this product urgently\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests"
					]
				},
				"description": "Create a new supply request. For product type, provide productId. For material type, provide materialId."
			},
			"response": []
		},
		{
			"name": "Create Material Supply Request",
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"type\": \"material\",\n    \"materialId\": 1,\n    \"quantity\": 2,\n    \"source\": \"Hospital supplier\",\n    \"notes\": \"Need two wheelchairs\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests"
					]
				},
				"description": "Create a new supply request for materials."
			},
			"response": []
		},
		{
			"name": "Update Supply Request",
			"request": {
				"method": "PATCH",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json",
						"type": "text"
					}
				],
				"body": {
					"mode": "raw",
					"raw": "{\n    \"quantity\": 15,\n    \"notes\": \"Updated: Increased quantity needed\"\n}"
				},
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests",
						"1"
					]
				},
				"description": "Update an existing supply request. Only include fields you want to update."
			},
			"response": []
		},
		{
			"name": "Delete Supply Request",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests/1",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests",
						"1"
					]
				},
				"description": "Delete a supply request by its ID."
			},
			"response": []
		},
		{
			"name": "Get Supply Requests By Date Range",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests/date-range?startDate=2025-01-01&endDate=2025-12-31",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests",
						"date-range"
					],
					"query": [
						{
							"key": "startDate",
							"value": "2025-01-01"
						},
						{
							"key": "endDate",
							"value": "2025-12-31"
						}
					]
				},
				"description": "Get all supply requests within a specific date range."
			},
			"response": []
		},
		{
			"name": "Get Supply Requests By Type",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "{{baseUrl}}/api/v1/supply-requests/type/product",
					"host": [
						"{{baseUrl}}"
					],
					"path": [
						"api",
						"v1",
						"supply-requests",
						"type",
						"product"
					]
				},
				"description": "Get all supply requests filtered by type (product or material)."
			},
			"response": []
		}
	],
