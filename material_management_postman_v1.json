{
  "info": {
    "name": "Material Management API",
    "description": "Collection for material types, materials, and material loans management",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Material Types",
      "item": [
        {
          "name": "Get All Material Types",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/material-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "material-types"]
            },
            "description": "Retrieve a list of all material types"
          }
        },
        {
          "name": "Get Material Type by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/material-types/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "material-types", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID of the material type"
                }
              ]
            },
            "description": "Retrieve a specific material type by ID"
          }
        },
        {
          "name": "Create Material Type",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wheelchair\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/material-types",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "material-types"]
            },
            "description": "Create a new material type"
          }
        },
        {
          "name": "Update Material Type",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Material Type Name\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/material-types/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "material-types", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID of the material type to update"
                }
              ]
            },
            "description": "Update an existing material type"
          }
        },
        {
          "name": "Delete Material Type",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/material-types/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "material-types", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1",
                  "description": "ID of the material type to delete"
                }
              ]
            },
            "description": "Delete a material type by ID"
          }
        }
      ]
    },
