{
  "info": {
    "name": "Celiac Sack Management API",
    "description": "Collection for celiac sack management endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Sack Management",
      "item": [
        {
          "name": "Get All Sacks",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks"]
            },
            "description": "Get all sacks in the system"
          }
        },
        {
          "name": "Create Sack",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks"]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Celiac Basic Pack\",\n  \"description\": \"Basic pack for celiac patients\",\n  \"products\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 3,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a new sack with products"
          }
        },
        {
          "name": "Get Sack",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ],
              "query": [
                {
                  "key": "version",
                  "value": "1",
                  "description": "Optional version to request",
                  "disabled": true
                }
              ]
            },
            "description": "Get a specific sack by ID, optionally specifying version"
          }
        },
        {
          "name": "Update Sack",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Updated Celiac Pack\",\n  \"description\": \"Updated pack description\",\n  \"isActive\": true\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Update sack details (name, description, active status)"
          }
        },
        {
          "name": "Delete Sack",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Soft delete a sack (marks as inactive)"
          }
        },
        {
          "name": "Create New Sack Version",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:id/version",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":id", "version"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"products\": [\n    {\n      \"productId\": 1,\n      \"quantity\": 3\n    },\n    {\n      \"productId\": 2,\n      \"quantity\": 2\n    },\n    {\n      \"productId\": 4,\n      \"quantity\": 1\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Create a new version of a sack with updated product list"
          }
        }
      ]
    },
    {
      "name": "Sack Products",
      "item": [
        {
          "name": "Get Sack Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "products"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                }
              ],
              "query": [
                {
                  "key": "version",
                  "value": "1",
                  "description": "Optional version to request",
                  "disabled": true
                }
              ]
            },
            "description": "Get all products in a specific sack, optionally for a specific version"
          }
        },
        {
          "name": "Add Product to Sack",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/products",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "products"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"productId\": 5,\n  \"quantity\": 2\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Add a product to the active version of a sack"
          }
        },
        {
          "name": "Update Product in Sack",
          "request": {
            "method": "PATCH",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/products/:productId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "products", ":productId"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                },
                {
                  "key": "productId",
                  "value": "3"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"quantity\": 3\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Update a product quantity in a sack (creates new version)"
          }
        },
        {
          "name": "Remove Product from Sack",
          "request": {
            "method": "DELETE",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/products/:productId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "products", ":productId"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                },
                {
                  "key": "productId",
                  "value": "2"
                }
              ]
            },
            "description": "Remove a product from a sack (creates new version)"
          }
        }
      ]
    },
    {
      "name": "Distribution Management",
      "item": [
        {
          "name": "Get All Distributions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/distributions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", "distributions"],
              "query": [
                {
                  "key": "from",
                  "value": "2023-01-01",
                  "description": "Filter distributions from this date",
                  "disabled": true
                },
                {
                  "key": "to",
                  "value": "2023-12-31",
                  "description": "Filter distributions to this date",
                  "disabled": true
                }
              ]
            },
            "description": "Get all sack distributions with optional date filtering"
          }
        },
        {
          "name": "Get Distribution",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/distributions/:id",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", "distributions", ":id"],
              "variable": [
                {
                  "key": "id",
                  "value": "1"
                }
              ]
            },
            "description": "Get a specific distribution by ID, including all products at time of distribution"
          }
        },
        {
          "name": "Get Patient Distributions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/distributions/patients/:patientId",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", "distributions", "patients", ":patientId"],
              "variable": [
                {
                  "key": "patientId",
                  "value": "1"
                }
              ]
            },
            "description": "Get all distributions for a specific patient"
          }
        },
        {
          "name": "Get Sack Distributions",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/distributions",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "distributions"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                }
              ]
            },
            "description": "Get all distributions for a specific sack"
          }
        },
        {
          "name": "Distribute Sack to Patient",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/distribute",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "distribute"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"patientId\": 1,\n  \"quantity\": 1,\n  \"notes\": \"Monthly distribution\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Distribute a sack to a patient, ensuring they haven't received one this month"
          }
        }
      ]
    },
    {
      "name": "Patient History and Eligibility",
      "item": [
        {
          "name": "Get Patient Distribution History",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/patients/:patientId/history",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", "patients", ":patientId", "history"],
              "variable": [
                {
                  "key": "patientId",
                  "value": "1"
                }
              ]
            },
            "description": "Get complete distribution history for a patient with statistics"
          }
        },
        {
          "name": "Get Eligible Patients",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/eligible-patients",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", "eligible-patients"],
              "query": [
                {
                  "key": "eligibleOnly",
                  "value": "true",
                  "description": "Only show patients who are eligible now",
                  "disabled": true
                }
              ]
            },
            "description": "Get all celiac patients with their eligibility status for the current month"
          }
        },
        {
          "name": "Distribute to All Eligible Patients",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/api/v1/sacks/:sackId/distribute-to-eligible",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "sacks", ":sackId", "distribute-to-eligible"],
              "variable": [
                {
                  "key": "sackId",
                  "value": "1"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"notes\": \"Bulk monthly distribution\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Distribute a sack to all eligible celiac patients who haven't received one this month"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000",
      "type": "string"
    }
  ]
}
